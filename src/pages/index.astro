---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';

const projects = await getCollection('projects');

const experience = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order);

const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order);

const profilePhoto = profile.profilePhoto || '';

const facebook = 'facebook' in profile ? profile.facebook : '';
const linkedin = 'linkedin' in profile ? profile.linkedin : '';
const telegram = 'telegram' in profile ? profile.telegram : '';
const cvFile = 'cvFile' in profile ? profile.cvFile : '';
const phone = 'phone' in profile ? String(profile.phone || '').trim() : '';
const viber = 'viber' in profile ? String(profile.viber || '').trim() : '';
const cleanPhone = phone.replace(/[^\d+]/g, '');
const cleanViber = viber.replace(/[^\d+]/g, '');
---

<Base title={profile.pageTitle}>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-inner">

      <!-- LEFT SIDE -->
      <div class="hero-content">

        <div class="eyebrow">
          {profile.eyebrow}
        </div>

        <h1>
          {profile.heroTitle}
          <em>{profile.heroHighlight}</em>
        </h1>

        <p class="lead">
          {profile.heroDescription}
        </p>

        <div class="actions">
          <a class="button" href="#portfolio">
            Explore My Work ↗
          </a>

          <a class="button secondary" href="#contact">
            Hire / Collaborate
          </a>
        </div>

        <div class="tags">
          <span>F&B OPERATIONS</span>
          <span>SALES STRATEGY</span>
          <span>DIGITAL MARKETING</span>
        </div>

      </div>

      <!-- RIGHT SIDE: PHOTO + NAME -->
      <div class="hero-panel">

        <div class="panel-mark">
          {profilePhoto ? (
            <img
              src={profilePhoto}
              alt={`${profile.name} - Profile Photo`}
              class="profile-photo"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="fallback-mark">
              H<span>·</span>B<span>·</span>D
            </div>
          )}
        </div>

        <div class="profile-name">
          <h2>{profile.name}</h2>
          <p>Hospitality · Business · Digital</p>
        </div>

      </div>

    </div>
  </section>

  <!-- ABOUT ME SECTION -->
  <section class="section" id="about">
    <div class="container split">

      <div>
        <div class="eyebrow">01 / ABOUT ME</div>

        <h2>
          {profile.aboutTitle}<br />
          <span class="gold">
            {profile.aboutHighlight}
          </span>
        </h2>
      </div>

      <div>
        <p>{profile.aboutText}</p>
        <p class="muted">{profile.aboutNote}</p>

        <div class="pills">
          <span class="pill">Hospitality</span>
          <span class="pill">Customer Experience</span>
          <span class="pill">Sales</span>
          <span class="pill">Social Media</span>
          <span class="pill">Campaign Strategy</span>
        </div>
      </div>

    </div>
  </section>

  <!-- EXPERIENCE SECTION -->
  <section class="section" id="experience">
    <div class="container">

      <div class="eyebrow">02 / CAREER</div>
      <h2>Professional Experience</h2>

      <p>
        My career journey and areas of responsibility.
      </p>

      <div class="stack">
        {experience.map((e) => (
          <article class="experience">

            <div>
              <span class="eyebrow">
                {e.data.period}
              </span>

              <h3>{e.data.title}</h3>
              <p>{e.data.company}</p>
            </div>

            <div>
              <span class="pill">
                {e.data.category}
              </span>

              <p>{e.body.slice(0, 250)}</p>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- PORTFOLIO SECTION -->
  <section class="section" id="portfolio">
    <div class="container">

      <div class="eyebrow">
        03 / SELECTED WORK
      </div>

      <h2>Portfolio & Case Studies</h2>

      <p>
        Projects are examples until replaced
        with verified work.
      </p>

      <div class="grid">
        {projects.map((p) => (
          <a
            class="card project"
            href={`/projects/${p.id}/`}
          >

            <div class="project-art">
              {p.data.image ? (
                <img
                  src={p.data.image}
                  alt={p.data.title}
                  loading="lazy"
                />
              ) : (
                <span>{p.data.category}</span>
              )}
            </div>

            <span class="eyebrow">
              {p.data.category}
            </span>

            <h3>{p.data.title} ↗</h3>
            <p>{p.data.summary}</p>

          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- SERVICES SECTION -->
  <section class="section" id="services">
    <div class="container">

      <div class="eyebrow">
        04 / WHAT I OFFER
      </div>

      <h2>Services & Expertise</h2>

      <div class="grid">
        {services.map((s, i) => (
          <article class="card">

            <span class="eyebrow">
              {String(i + 1).padStart(2, '0')}
            </span>

            <h3>{s.data.title}</h3>
            <p>{s.data.summary}</p>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="section" id="contact">
    <div class="container contact">

      <div class="eyebrow">
        05 / GET IN TOUCH
      </div>

      <h2>
        Let's build something<br />
        <span class="gold">
          meaningful together.
        </span>
      </h2>

      <p>{profile.contactText}</p>

      <div class="contact-actions">
        <a
          class="button"
          href={`mailto:${profile.email}`}
        >
          Email Me ↗
        </a>

        {cvFile && (
          <a
            class="button secondary"
            href={cvFile}
            target="_blank"
            rel="noopener noreferrer"
          >
            Download CV ↓
          </a>
        )}
      </div>

      <div class="social-links">
        {cleanPhone && (
          <a href={`tel:${cleanPhone}`} aria-label={`Call ${phone}`}>
            📞 Call Me
          </a>
        )}

        {cleanViber && (
          <a href={`viber://chat?number=${encodeURIComponent(cleanViber)}`} aria-label={`Contact on Viber ${viber}`}>
            💬 Viber
          </a>
        )}

        {facebook && (
          <a
            href={facebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook ↗
          </a>
        )}

        {linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>
        )}

        {telegram && (
          <a
            href={telegram}
            target="_blank"
            rel="noopener noreferrer"
          >
            Telegram ↗
          </a>
        )}
      </div>

    </div>
  </section>

</Base>

<style>
  /* HERO */

  .hero {
    min-height: 650px;
    display: flex;
    align-items: center;
    background: radial-gradient(
      circle at 80% 40%,
      #1c3046,
      #09121f 55%
    );
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: 60px;
    align-items: center;
    padding-top: 70px;
    padding-bottom: 100px;
  }

  .hero-content {
    min-width: 0;
  }

  .hero h1 {
    font-size: clamp(52px, 7vw, 98px);
    line-height: 1.07;
    letter-spacing: -2px;
    max-width: 760px;
    margin: 24px 0;
  }

  .hero h1 em {
    display: block;
    color: #d7b678;
    font-weight: 500;
  }

  .lead {
    font-size: 17px;
    max-width: 630px;
  }

  .actions {
    margin: 32px 0 48px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    font-size: 10px;
    letter-spacing: 2px;
    color: #8293a6;
  }

  /* RIGHT PROFILE PANEL */

  .hero-panel {
    min-width: 0;
    min-height: 410px;
    border: 1px solid #5a5d57;
    background: linear-gradient(
      135deg,
      #1a2a3c,
      #101923
    );
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    text-align: center;
    box-shadow: 20px 25px 0 #111e2d;
  }

  .panel-mark {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .fallback-mark {
    font-family: Georgia, serif;
    font-size: 64px;
  }

  .fallback-mark span {
    color: #d7b678;
  }

  /* PROFILE PHOTO */

  .profile-photo {
    display: block;
    width: 100%;
    max-width: 260px;
    height: 260px;
    object-fit: cover;
    object-position: center top;
    border-radius: 10px;
    border: 2px solid #d7b678;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }

  /* PROFILE NAME */

  .profile-name {
    width: 100%;
  }

  .profile-name h2 {
    color: #ffffff;
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 2.3vw, 26px);
    line-height: 1.3;
    overflow-wrap: anywhere;
    margin: 0 0 8px;
  }

  .profile-name p {
    color: #d7b678;
    font-size: 11px;
    letter-spacing: 1px;
    line-height: 1.6;
    margin: 0;
  }

  /* ABOUT */

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
  }

  /* EXPERIENCE */

  .experience {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    padding: 28px 0;
    border-bottom: 1px solid #28384b;
  }

  .experience h3 {
    font-size: 24px;
    margin: 12px 0;
  }

  /* PROJECTS */

  .project {
    display: block;
    padding: 0 0 20px;
    overflow: hidden;
  }

  .project > .eyebrow,
  .project > h3,
  .project > p {
    margin-left: 22px;
    margin-right: 22px;
  }

  .project-art {
    height: 210px;
    background: linear-gradient(
      135deg,
      #213b55,
      #0c1625
    );
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    color: #d7b678;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 12px;
  }

  .project-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* CONTACT */

  .contact {
    text-align: center;
  }

  .contact p {
    max-width: 600px;
    margin: 0 auto 30px;
  }

  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .contact-actions .button {
    margin-right: 0;
  }

  .social-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .social-links a {
    border: 1px solid #d7b678;
    border-radius: 5px;
    padding: 12px 20px;
    color: #d7b678;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s, color 0.2s;
  }

  .social-links a:hover {
    background: #d7b678;
    color: #09121f;
  }

  /* TABLET & MOBILE */

  @media (max-width: 800px) {
    .hero-inner,
    .split {
      grid-template-columns: 1fr;
    }

    .hero-inner {
      gap: 35px;
      padding-top: 55px;
      padding-bottom: 70px;
    }

    .hero h1 {
      font-size: clamp(42px, 10vw, 68px);
      letter-spacing: -1px;
    }

    .hero-panel {
      min-height: 340px;
      padding: 24px;
      gap: 16px;
      box-shadow: none;
    }

    .profile-photo {
      max-width: 220px;
      height: 220px;
    }

    .profile-name h2 {
      font-size: 23px;
    }

    .experience {
      grid-template-columns: 1fr;
    }

    .tags {
      gap: 12px;
    }

    .actions .button {
      margin-bottom: 10px;
    }
  }

  @media (max-width: 480px) {
    .hero-panel {
      min-height: 320px;
      padding: 20px;
    }

    .profile-photo {
      max-width: 200px;
      height: 200px;
    }

    .profile-name h2 {
      font-size: 21px;
    }

    .profile-name p {
      font-size: 10px;
    }

    .contact-actions {
      gap: 10px;
    }
  }
</style>
