---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
const projects=await getCollection('projects');
const experience=(await getCollection('experience')).sort((a,b)=>a.data.order-b.data.order);
const services=(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order);
---
<Base title="Your Name | Hospitality, Sales & Digital Marketing"><section class="hero"><div class="container hero-inner"><div><div class="eyebrow">HOSPITALITY · BUSINESS · DIGITAL</div><h1>Where Operations Meet <em>Growth.</em></h1><p class="lead">A versatile professional bringing together Food & Beverage Operations, Sales & Marketing, and Digital Marketing to create meaningful business impact.</p><div class="actions"><a class="button" href="#portfolio">Explore My Work ↗</a><a class="button secondary" href="#contact">Hire / Collaborate</a></div><div class="tags"><span>F&B OPERATIONS</span><span>SALES STRATEGY</span><span>DIGITAL MARKETING</span></div></div><div class="hero-panel"><div class="panel-top">THE PROFESSIONAL PROFILE</div><div class="panel-mark">H<span>·</span>B<span>·</span>D</div><div class="panel-bottom">Hospitality<br/>Business<br/>Digital</div></div></div></section>
<section class="section" id="about"><div class="container split"><div><div class="eyebrow">01 / ABOUT ME</div><h2>One professional.<br/><span class="gold">Multiple perspectives.</span></h2></div><div><p>I work across hospitality operations, commercial strategy, and digital marketing. This portfolio brings together my professional experience, selected projects and the services I can offer.</p><p class="muted">Replace this introduction with your verified background, strengths and career goals using your website content files.</p><div class="pills"><span class="pill">Hospitality</span><span class="pill">Customer Experience</span><span class="pill">Sales</span><span class="pill">Social Media</span><span class="pill">Campaign Strategy</span></div></div></div></section>
<section class="section" id="experience"><div class="container"><div class="eyebrow">02 / CAREER</div><h2>Professional Experience</h2><p>My career journey and areas of responsibility.</p><div class="stack">{experience.map(e=><article class="experience"><div><span class="eyebrow">{e.data.period}</span><h3>{e.data.title}</h3><p>{e.data.company}</p></div><div><span class="pill">{e.data.category}</span><p>{e.body.slice(0,250)}</p></div></article>)}</div></div></section>
<section class="section" id="portfolio"><div class="container"><div class="eyebrow">03 / SELECTED WORK</div><h2>Portfolio & Case Studies</h2><p>Projects are examples until replaced with verified work.</p><div class="grid">{projects.map(p=><a class="card project" href={`/projects/${p.id}/`}><div class="project-art">{p.data.image?<img src={p.data.image} alt={p.data.title}/>:<span>{p.data.category}</span>}</div><span class="eyebrow">{p.data.category}</span><h3>{p.data.title} ↗</h3><p>{p.data.summary}</p></a>)}</div></div></section>
<section class="section" id="services"><div class="container"><div class="eyebrow">04 / WHAT I OFFER</div><h2>Services & Expertise</h2><div class="grid">{services.map((s,i)=><article class="card"><span class="eyebrow">0{i+1}</span><h3>{s.data.title}</h3><p>{s.data.summary}</p></article>)}</div></div></section>
<section class="section" id="contact"><div class="container contact"><div class="eyebrow">05 / GET IN TOUCH</div><h2>Let's build something<br/><span class="gold">meaningful together.</span></h2><p>Open to relevant career opportunities, professional connections and freelance collaborations.</p><a class="button" href="mailto:hello@example.com">Email Me ↗</a><p class="muted tiny">Replace hello@example.com with your real email address before publishing.</p></div></section></Base>
<style>.hero{min-height:650px;display:flex;align-items:center;background:radial-gradient(circle at 80% 40%,#1c3046,#09121f 55%)}.hero-inner{display:grid;grid-template-columns:1.35fr .65fr;gap:60px;align-items:center;padding-top:70px;padding-bottom:100px}.hero h1{font-size:clamp(52px,7vw,98px);line-height:1.07;letter-spacing:-2px;max-width:760px;margin:24px 0}.hero h1 em{color:#d7b678;font-weight:500}.lead{font-size:17px;max-width:630px}.actions{margin:32px 0 48px}.tags{display:flex;flex-wrap:wrap;gap:22px;font-size:10px;letter-spacing:2px;color:#8293a6}.hero-panel{height:410px;border:1px solid #5a5d57;background:linear-gradient(135deg,#1a2a3c,#101923);padding:30px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:20px 25px 0 #111e2d}.panel-top{letter-spacing:3px;color:#b9aa86;font-size:10px}.panel-mark{font-family:Georgia,serif;font-size:64px;text-align:center}.panel-mark span{color:#d7b678}.panel-bottom{text-align:right;text-transform:uppercase;letter-spacing:3px;font-size:12px;line-height:2;color:#b4c0cc}.split{display:grid;grid-template-columns:1fr 1fr;gap:70px}.experience{display:grid;grid-template-columns:1fr 1fr;gap:25px;padding:28px 0;border-bottom:1px solid #28384b}.experience h3{font-size:24px;margin:12px 0}.project{display:block;padding:0 0 20px;overflow:hidden}.project>.eyebrow,.project>h3,.project>p{margin-left:22px;margin-right:22px}.project-art{height:210px;background:linear-gradient(135deg,#213b55,#0c1625);display:flex;align-items:center;justify-content:center;margin-bottom:24px;color:#d7b678;text-transform:uppercase;letter-spacing:2px;font-size:12px}.project-art img{width:100%;height:100%;object-fit:cover}.contact{text-align:center}.contact p{max-width:600px;margin:0 auto 30px}.tiny{font-size:12px;margin-top:18px!important}@media(max-width:800px){.hero-inner,.split{grid-template-columns:1fr}.hero-inner{gap:25px}.hero-panel{height:230px;box-shadow:none}.panel-mark{font-size:40px}.hero h1{letter-spacing:-1px}.experience{grid-template-columns:1fr}.tags{gap:12px}.actions .button{margin-bottom:10px}}
</style>
