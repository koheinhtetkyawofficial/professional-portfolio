
---
import profile from '../data/profile.json';

const {
  title = profile.pageTitle || 'Professional Portfolio',
  description = profile.heroDescription ||
    'F&B Operations, Sales & Marketing and Digital Marketing professional portfolio'
} = Astro.props;

const siteName = profile.name || 'Your Name';
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <!-- HEADER -->
    <header class="nav">

      <a
        class="brand"
        href="/"
        aria-label={`${siteName} homepage`}
      >
        {siteName}<span>.</span>
      </a>

      <!-- DESKTOP NAVIGATION -->
      <nav
        class="desktop-nav"
        aria-label="Main navigation"
      >
        <a href="/#about">About</a>
        <a href="/#experience">Experience</a>
        <a href="/#portfolio">Portfolio</a>
        <a href="/#services">Services</a>
        <a href="/#contact">Contact</a>
      </nav>

      <a class="nav-cta" href="/#contact">
        Let's Talk ↗
      </a>

      <!-- MOBILE NAVIGATION -->
      <details class="mobile-menu">
        <summary aria-label="Toggle navigation menu">
          <span class="menu-open-icon" aria-hidden="true">☰</span>
          <span class="menu-close-icon" aria-hidden="true">✕</span>
        </summary>

        <nav aria-label="Mobile navigation">
          <a href="/#about">About</a>
          <a href="/#experience">Experience</a>
          <a href="/#portfolio">Portfolio</a>
          <a href="/#services">Services</a>
          <a href="/#contact">Contact</a>
        </nav>
      </details>

    </header>

    <!-- MAIN CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer>
      <span>
        © {currentYear} {siteName} · Professional Portfolio
      </span>

      <span>
        Built with Astro · Hosted on Cloudflare Pages
      </span>
    </footer>

    <script>
      const mobileMenu = document.querySelector<HTMLDetailsElement>(
        '.mobile-menu'
      );

      if (mobileMenu) {
        const menuLinks = mobileMenu.querySelectorAll('nav a');

        menuLinks.forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.open = false;
          });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            mobileMenu.open = false;
          }
        });

        document.addEventListener('click', (event) => {
          if (
            mobileMenu.open &&
            event.target instanceof Node &&
            !mobileMenu.contains(event.target)
          ) {
            mobileMenu.open = false;
          }
        });
      }
    </script>

  </body>
</html>

<style is:global>
  :root {
    font-family: 'DM Sans', sans-serif;
    background: #09121f;
    color: #edf1f4;
    scroll-behavior: smooth;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1, h2, h3, p {
    margin-top: 0;
  }

  h1, h2 {
    font-family: 'Playfair Display', serif;
  }

  p {
    line-height: 1.75;
    color: #abb8c9;
  }

  /* NAVIGATION */

  .nav {
    max-width: 1200px;
    margin: auto;
    padding: 26px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    position: relative;
    z-index: 100;
  }

  .brand {
    font-weight: 700;
    letter-spacing: 2px;
    overflow-wrap: anywhere;
  }

  .brand span,
  .eyebrow,
  .gold {
    color: #d7b678;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 13px;
    color: #b7c2d0;
  }

  .desktop-nav a {
    transition: color 0.2s ease;
  }

  .desktop-nav a:hover {
    color: #d7b678;
  }

  .nav-cta {
    border: 1px solid #bba16f;
    padding: 12px 20px;
    font-size: 13px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: #d7b678;
    color: #09121f;
  }

  /* MOBILE MENU - HIDDEN ON DESKTOP */

  .mobile-menu {
    display: none;
    position: relative;
    flex-shrink: 0;
  }

  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    color: #d7b678;
    border: 1px solid #526075;
    border-radius: 5px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    user-select: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary:focus-visible {
    outline: 2px solid #d7b678;
    outline-offset: 3px;
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-menu[open] .menu-open-icon {
    display: none;
  }

  .mobile-menu[open] .menu-close-icon {
    display: inline;
  }

  .mobile-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: min(280px, calc(100vw - 40px));
    background: #111f30;
    border: 1px solid #526075;
    border-radius: 8px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    z-index: 200;
  }

  .mobile-menu nav a {
    display: block;
    padding: 13px 14px;
    border-radius: 5px;
    color: #edf1f4;
    font-size: 14px;
  }

  .mobile-menu nav a:hover,
  .mobile-menu nav a:focus-visible {
    background: #1b3047;
    color: #d7b678;
  }

  /* CONTAINERS */

  .container {
    max-width: 1200px;
    margin: auto;
    padding: 0 28px;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 11px;
    font-weight: 700;
  }

  /* SECTIONS */

  .section {
    padding: 90px 0;
    border-top: 1px solid #263448;
  }

  .section h2 {
    font-size: clamp(32px, 5vw, 53px);
    line-height: 1.17;
  }

  /* GRID & CARDS */

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .card {
    background: #111f30;
    border: 1px solid #28384b;
    border-radius: 8px;
    padding: 27px;
    min-width: 0;
  }

  .card h3 {
    font-size: 20px;
  }

  /* PILLS */

  .pill {
    display: inline-block;
    border: 1px solid #526075;
    border-radius: 20px;
    padding: 7px 12px;
    margin: 5px 5px 0 0;
    color: #d4dce7;
    font-size: 12px;
  }

  /* BUTTONS */

  .button {
    display: inline-block;
    background: #d7b678;
    color: #111925;
    padding: 15px 22px;
    font-weight: 700;
    border-radius: 3px;
    margin-right: 12px;
  }

  .button.secondary {
    background: transparent;
    color: #fff;
    border: 1px solid #7a899c;
  }

  .muted {
    color: #9facbc;
  }

  /* FOOTER */

  footer {
    max-width: 1200px;
    margin: auto;
    border-top: 1px solid #263448;
    padding: 30px 28px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #8292a4;
    font-size: 12px;
  }

  /* MOBILE RESPONSIVE */

  @media (max-width: 800px) {
    .desktop-nav {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .mobile-menu {
      display: block;
      margin-left: auto;
    }

    .nav {
      padding: 20px;
      gap: 12px;
    }

    .brand {
      font-size: 14px;
      letter-spacing: 1px;
    }

    .container {
      padding: 0 20px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .section {
      padding: 65px 0;
    }

    footer {
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .nav {
      padding: 16px 20px;
    }

    .brand {
      font-size: 13px;
    }

    .mobile-menu summary {
      width: 42px;
      height: 42px;
    }
  }
</style>
